PORT=3000
DATABASE_URL="file:./dev.db"
ADMIN_PASSWORD="replace-with-a-strong-unique-password"
SESSION_SECRET="replace-with-a-random-secret"
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"
QUIZ_STORE="memory"

# Optional for running against Firebase locally; Cloud Functions reads the
# database URL from Firebase's runtime config when available.
# FIREBASE_DATABASE_URL="https://YOUR_DATABASE.REGION.firebasedatabase.app"

# Optional legacy Upstash mode only. Keep credentials out of GitHub.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
