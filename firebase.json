{
  "functions": {
    "source": ".",
    "runtime": "nodejs22",
    "ignore": [
      ".git/**",
      ".firebase/**",
      "node_modules/**",
      "**/node_modules/**",
      ".env",
      ".env.*",
      "*.db",
      "*.db-journal",
      "coverage/**",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "quizApi",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
